{
    "name": "hradigital/php-datatypes",
    "description": "Easy way to build up and sanitize your application objects.",
    "type": "library",
    "license": "MPL-2.0",
    "authors": [
        {
            "name": "Hugo Rafael Azevedo",
            "email": "github@hradigital.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "keywords": [
        "php",
        "datatypes",
        "ddd",
        "domain driven design",
        "domain",
        "aggregates",
        "entity",
        "entities",
        "value objects",
        "scalar objects",
        "immutable objects",
        "mutable objects"
    ],
    "require": {
        "php": "^8.2",
        "ext-intl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.0@dev || ^4.0",
        "phpstan/phpstan": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "HraDigital\\Datatypes\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HraDigital\\Tests\\Datatypes\\": "tests/"
        }
    },
    "scripts": {
        "test-code" : "./vendor/bin/phpunit --log-junit ci/tests-results.xml",
        "test-cs" : "./vendor/bin/phpcs -p --colors --no-cache --report=full",
        "test-static" : "./vendor/bin/phpstan analyse --no-progress",
        "test-all" : "composer run test-code && composer run test-cs && composer run test-static"
    }
}
